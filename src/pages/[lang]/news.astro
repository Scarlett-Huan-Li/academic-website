---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getTranslations } from '../../i18n/ui';
import FormattedDate from '../../components/FormattedDate.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } },
    { params: { lang: 'hu' } },
  ];
}

const { lang } = Astro.params;
const t = getTranslations(lang);
const htmlLang = lang === 'zh' ? 'zh-Hans' : lang;

const news: { date: Date; title: string; category: string; content: string; link?: string; image?: string; imageAlt?: string }[] = [
	{
		date: new Date('2026-11-14'),
		title: 'GeoLab is recruiting PhD students, joint-training students and visiting scholars for 2027',
		category: 'Recruitment',
		content: 'GeoLab at the HUN-REN Balaton Limnological Research Institute welcomes new PhD students, joint-training PhD students, visiting scholars and postdocs who want to study lakes, water resources and climate change with satellite remote sensing, Google Earth Engine and AI. Applicants can come through the Sino-Hungarian exchange scholarship / Stipendium Hungaricum, CSC joint-training and visiting programmes, or project funding. Scholarship rounds for the 2027/28 academic year close in winter, so please get in touch early.',
		link: 'join',
	},
	{
		date: new Date('2026-11-06'),
		title: 'New Publication in ISPRS Journal of Photogrammetry and Remote Sensing: TS-PFDM for Thick Cloud Removal',
		category: 'Publication',
		content: 'Our paper "TS-PFDM: a temporally scaled probability-flow diffusion model for thick cloud removal in remote sensing images" (Gao, X., Xie, X., Yang, Y., Wang, N., Huang, R., Li, H.) has been published in ISPRS Journal of Photogrammetry and Remote Sensing (vol. 243, 88–112). The diffusion-based model reconstructs the land and water surface hidden under thick clouds, which removes one of the main obstacles to dense optical time series over lakes.',
	},
	{
		date: new Date('2026-10-27'),
		title: 'Call for Abstracts: EGU27 Session HS10.13 "Smart Lake"',
		category: 'Service',
		content: 'Our session "Smart Lake: remote sensing, in-situ networks and AI for monitoring and early warning of aquatic ecosystems" (HS10.13) has been accepted for the EGU General Assembly 2027 in Vienna. It is convened by Huan Li together with Hongtao Duan and Juhua Luo from the Nanjing Institute of Geography and Limnology, Chinese Academy of Sciences. Contributions on water-quality retrieval, in-situ and satellite integration, multi-decadal reconstruction, AI-based bloom forecasting and open tools are welcome, especially comparative studies across lakes and from early-career scientists. Abstract deadline: 12 January 2027, 13:00 CET.',
		link: 'egu27',
	},
	{
		date: new Date('2026-10-25'),
		title: 'Invited Keynote in Nanjing and the Chinese–Hungarian International Cooperation Forum at NIGLAS',
		category: 'Talk',
		content: 'At the 8th China Wetland Remote Sensing Conference in Nanjing I gave the invited keynote "Doing Research in Hungary: Academic System, Funding and Cooperation Opportunities". In the afternoon, five researchers from the HUN-REN Balaton Limnological Research Institute presented at the Chinese–Hungarian International Cooperation Forum hosted by the Nanjing Institute of Geography and Limnology, Chinese Academy of Sciences (NIGLAS); my talk was "Remote Sensing of Lake Balaton: Warming, Water Quality and Prospects for Balaton–Taihu Comparison". On 26 October the delegation visited the Taihu field station. Lake Balaton and Lake Taihu are both large, shallow lakes facing similar pressures, and our Chinese partners will visit Tihany in 2027.',
		link: 'research',
	},
	{
		date: new Date('2026-09-03'),
		title: 'Invited Keynote and Google Earth Engine Workshop at SCCS Europe 2026',
		category: 'Talk',
		content: 'At the 11th Student Conference on Conservation Science (SCCS Europe 2026) in Balatonvilágos, Hungary, I gave the invited keynote "Water from Above: How Satellites Are Changing the Way We Monitor Aquatic Ecosystems — and What Lake Balaton Can Tell Us" and led the hands-on workshop "Monitoring Ecosystems from Space: An AI-Assisted Introduction to Google Earth Engine".',
		link: 'cv',
	},
	{
		date: new Date('2026-05-15'),
		title: 'Two New Papers in IEEE Transactions on Geoscience and Remote Sensing',
		category: 'Publication',
		content: 'Two collaborative papers have been published in IEEE TGRS: "Wind-Driven Regime of GNSS-R Signatures in Northern Lakes for Lake Ice Detection" (Guo, Z., Wan, W., Liu, B., Wan, X., Zhang, J., Hu, X., Li, H.) and "Integrity Extraction of Water Bodies in Complex Scenes Based on the Adaptive Watermamba Framework" (Yang, D., Gao, X., Tao, Y., Yang, Y., Guo, K., Han, K., Xu, L., Li, H.). Together they extend our surface-water work to spaceborne GNSS reflectometry and to state-space deep learning models.',
	},
	{
		date: new Date('2026-05-04'),
		title: 'Oral Presentation at EGU26: the PanLake Framework',
		category: 'Talk',
		content: 'I presented "PanLake: A Transferable Framework for Monitoring Trophic Dynamics in Shallow Lakes" (EGU26-13554) in session HS10.11 "Inland waters\' response to climatic change" at the European Geosciences Union General Assembly in Vienna. Built on four decades of 30 m Landsat chlorophyll-a for Lake Balaton, the framework is now being transferred to Lake Taihu together with NIGLAS and Bangor University.',
		link: 'research',
	},
	{
		date: new Date('2026-01-19'),
		title: 'New Publication in Journal of Hydrology: Regional Studies: Global Long-Term Daily Streamflow Reconstruction',
		category: 'Publication',
		content: 'Our paper "Reconstruction of global long-term daily streamflow dataset using machine learning models for revealing streamflow changes" (Gao, Y., Luo, Z., Liu, H., Wang, L., Chen, X., Li, H.) has been published in Journal of Hydrology: Regional Studies (64:103148).',
	},
	{
		date: new Date('2026-01-01'),
		title: 'Hungarian–Chinese Bilateral Project Started: Smart Lake Monitoring for Lake Taihu and Lake Balaton',
		category: 'Grant',
		content: 'The two-year project "Smart Lake Monitoring and Early Warning of Aquatic Ecosystems for Lake Taihu and Lake Balaton" (2026–2027) has started under the Hungarian–Chinese Bilateral Collaboration Programme, with me as the Hungarian Principal Investigator and the Nanjing Institute of Geography and Limnology, Chinese Academy of Sciences, as the Chinese partner. The project combines long-term satellite records, high-frequency in-situ monitoring and AI to compare the two lakes and to develop early warning of algal blooms.',
		link: 'research',
	},
	{
		date: new Date('2025-11-05'),
		title: 'Seminar at Nanyang Technological University, Singapore',
		category: 'Talk',
		content: 'Within the HUN-REN – NTU AI Research Cooperation Programme I gave the seminar "Satellite Remote Sensing for Environmental Monitoring Under Climate Change: From Surface Water to Lake Ecosystems" at the NTU Centre for Computational Data Science.',
		link: 'cv',
	},
	{
		date: new Date('2026-01-15'),
		title: 'New Publication in Water Research: Four Decades of Satellite Observations Reveal Climate-Driven Shifts in Shallow Lake Chlorophyll-a Dynamics',
		category: 'Publication',
		content: 'Our latest research on "Four decades of satellite observations reveal climate-driven shifts and spatial heterogeneity in shallow lake Chlorophyll-a dynamics" has been published in Water Research (Volume 289, 124925). This comprehensive study analyzes 40 years of Landsat satellite observations to reveal climate-driven shifts in chlorophyll-a dynamics in Lake Balaton, Hungary, providing critical insights into long-term water quality changes and their relationship with climate variability.',
	},
	{
		date: new Date('2025-09-01'),
		title: 'HUN-REN – NTU AI Research Cooperation Programme Grant Awarded',
		category: 'Grant',
		content: 'Received grant from HUN-REN – NTU AI Research Cooperation Programme 2025 for the project "Perceptual AI Framework for Integrated Satellite and Multi-Source Aquatic Environment Monitoring" (NTU: Nanyang Technological University). This project will develop advanced AI frameworks for integrated satellite and multi-source aquatic environment monitoring.',
	},
	{
		date: new Date('2025-01-15'),
		title: 'New Publication in Scientific Data: Monthly Snow Depth Dataset from CMIP6 Models',
		category: 'Publication',
		content: 'Our latest research on "Monthly 0.05° winter months snow depth dataset for the Northern Hemisphere from 21 CMIP6 models" has been published in Scientific Data. This work provides a comprehensive dataset for climate modeling and snow cover analysis across the Northern Hemisphere.',
	},
	{
		date: new Date('2025-01-10'),
		title: 'New Publication in Catena: Century-Long Streamflow Reconstruction',
		category: 'Publication',
		content: 'Our research on "A century-long streamflow reconstruction reveals significant streamflow increases in the upper Yangtze River basin" has been published in Catena. This study provides critical insights into long-term hydrological changes in one of China\'s most important river systems.',
	},
	{
		date: new Date('2024-12-20'),
		title: 'Session Chair at Fresh Blood for Freshwater 2025 Conference',
		category: 'Service',
		content: 'Serving as Session Chair at the Fresh Blood for Freshwater 2025 conference organized by HUN-REN Institute of Aquatic Ecology, Hungary. This conference brings together young researchers working on freshwater ecosystems and climate change impacts.',
	},
	{
		date: new Date('2024-11-15'),
		title: 'New Publication: 150-Year Water Temperature Analysis in Pannonian Region',
		category: 'Publication',
		content: 'Our comprehensive study on "150-year daily data (1870–2021) in lakes and rivers reveals intensifying surface water warming and heatwaves in the Pannonian Ecoregion (Hungary)" has been published in Journal of Hydrology: Regional Studies. This work reveals significant warming trends in Central European water bodies.',
	},
	{
		date: new Date('2024-10-01'),
		title: 'European Space Agency Network of Resources Grant Awarded',
		category: 'Grant',
		content: 'Received grant from European Space Agency Network of Resources (NoR) for the project "Mining spatio-temporal patterns of 40-year surface water temperature for lakes and rivers in the Pannonian ecoregion". This project will analyze long-term water temperature trends using remote sensing data.',
	},
	{
		date: new Date('2024-09-20'),
		title: 'New Publication: Lake Balaton Water Temperature Study',
		category: 'Publication',
		content: 'Our research on "Exploring spatiotemporal features of surface water temperature for Lake Balaton in the 21st century based on Google Earth Engine" has been published in Journal of Hydrology. This study demonstrates the power of cloud computing for environmental monitoring.',
	},
	{
		date: new Date('2024-08-15'),
		title: 'New Publication: Global Bathymetric Analysis of Inland Waters',
		category: 'Publication',
		content: 'Our collaborative work on "Exploring the topographical pattern beneath the water surface: Global Bathymetric Volume-Area-Height curves (BVAH) of inland surface water bodies" has been published in Geodesy and Geodynamics. This provides a global perspective on inland water body characteristics.',
	},
	{
		date: new Date('2024-05-20'),
		title: 'New Publication: Remote Sensing Monitoring in China',
		category: 'Publication',
		content: 'Our review paper on "Inspects and prospects of satellite remote sensing monitoring ability for land surface water in China" has been published in National Remote Sensing Bulletin. This work assesses the current state and future directions of water monitoring in China.',
	},
	{
		date: new Date('2022-01-01'),
		title: 'Senior Research Fellow Position at HUN-REN Balaton Limnological Research Institute',
		category: 'Appointment',
		content: 'Started new position as Senior Research Fellow at HUN-REN Balaton Limnological Research Institute, Hungary. Focusing on remote sensing-based environmental research under climate change, particularly studying the impacts on aquatic ecosystems in the Pannonian region.',
	},
	{
		date: new Date('2021-02-13'),
		title: 'Life Member of European Geosciences Union',
		category: 'Membership',
		content: 'Became a Life Member of the European Geosciences Union (EGU), joining a prestigious community of geoscientists working on Earth and planetary sciences. This membership provides access to international conferences and collaboration opportunities.',
	},
	{
		date: new Date('2021-01-01'),
		title: 'Annual Best Paper Award at Peking University',
		category: 'Award',
		content: 'Received the Annual Best Paper award from the Institute of Remote Sensing and Geographic Information System (IRGIS) at Peking University, China, recognizing outstanding research contributions in remote sensing and geospatial analysis.',
	},
	{
		date: new Date('2020-01-01'),
		title: 'Youth Foundation Grant from National Natural Science Foundation of China',
		category: 'Grant',
		content: 'Awarded grant from Youth Foundation of National Natural Science Foundation of China for the project "Retrieving key parameters of circum-Antarctic sea ice with altimeter satellites and their spatio-temporal changes".',
	},
	{
		date: new Date('2019-01-01'),
		title: 'First Prize at The First Youth Forum of IRGIS',
		category: 'Award',
		content: 'Won First Prize at The First Youth Forum of IRGIS at Peking University, China, for outstanding research presentation and contributions to remote sensing and geographic information science.',
	},
	{
		date: new Date('2019-01-01'),
		title: 'China Post-doc Foundation Grant Awarded',
		category: 'Grant',
		content: 'Received grant from China Post-doc Foundation for the project "Retrieving Antarctic sea-ice thickness and volume from ICESat and spatio-temporal variability analysis".',
	},
	{
		date: new Date('2018-01-01'),
		title: 'Annual Best Paper Award at Peking University',
		category: 'Award',
		content: 'Received the Annual Best Paper award from IRGIS at Peking University, China, for exceptional research contributions in remote sensing and geographic information systems.',
	}
];
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead title={`${t('news.title')} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>{t('news.title')}</h1>
				<p class="page-subtitle">{t('news.subtitle')}</p>
			</div>

			<div class="news-filters">
				<button class="filter-btn active" data-category="all">{t('news.filter.all')}</button>
				<button class="filter-btn" data-category="Publication">{t('news.filter.publications')}</button>
				<button class="filter-btn" data-category="Talk">{t('news.filter.talks')}</button>
			<button class="filter-btn" data-category="Grant">{t('news.filter.grants')}</button>
			<button class="filter-btn" data-category="Recruitment">{t('news.filter.recruitment')}</button>
				<button class="filter-btn" data-category="Award">{t('news.filter.awards')}</button>
				<button class="filter-btn" data-category="Service">{t('news.filter.service')}</button>
				<button class="filter-btn" data-category="Appointment">{t('news.filter.appointments')}</button>
				<button class="filter-btn" data-category="Membership">{t('news.filter.memberships')}</button>
			</div>

			<div class="news-timeline">
				{news.map((item) => (
					<div class="news-card" data-category={item.category.toLowerCase()}>
						<div class="news-meta">
							<FormattedDate date={item.date} />
							<span class="category">{t(('news.category.' + item.category) as any)}</span>
						</div>
						<h2>{item.title}</h2>
						{item.image && <img src={item.image} alt={item.imageAlt} class="news-image" loading="lazy" />}
						<p>{item.content}</p>
						<div class="news-actions">
							{item.link === 'join' && <a href={`/${lang}/join`} class="read-more">{t('news.view_join')}</a>}
							{item.link === 'egu27' && <a href={`/${lang}/egu27`} class="read-more">{t('index.egu.cta')}</a>}
							{item.link === 'cv' && <a href={`/${lang}/cv`} class="read-more">{t('news.view_cv')}</a>}
							{item.link === 'research' && <a href={`/${lang}/research`} class="read-more">{t('news.view_research')}</a>}
							{!item.link && <a href={`/${lang}/publications`} class="read-more">{t('news.view_pubs')}</a>}
						</div>
					</div>
				))}
			</div>

			<div class="news-summary">
				<h2>{t('news.highlights.heading')}</h2>
				<div class="summary-grid">
					<div class="summary-card">
						<h3>{t('news.highlights.pubs.title')}</h3>
						<p class="summary-number">50+</p>
						<p class="summary-text">{t('news.highlights.pubs.desc')}</p>
					</div>
					<div class="summary-card">
						<h3>{t('news.highlights.grants.title')}</h3>
						<p class="summary-number">5</p>
						<p class="summary-text">{t('news.highlights.grants.desc')}</p>
					</div>
					<div class="summary-card">
						<h3>{t('news.highlights.awards.title')}</h3>
						<p class="summary-number">7</p>
						<p class="summary-text">{t('news.highlights.awards.desc')}</p>
					</div>
					<div class="summary-card">
						<h3>{t('news.highlights.service.title')}</h3>
						<p class="summary-number">29</p>
						<p class="summary-text">{t('news.highlights.service.desc')}</p>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		text-align: center;
		margin-bottom: 3em;
		padding: 2em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.page-header h1 {
		margin-bottom: 0.5em;
		color: rgb(var(--black));
	}

	.page-subtitle {
		font-size: 1.2em;
		color: rgb(var(--gray));
		margin: 0;
		font-style: italic;
	}

	.news-filters {
		margin: 2em 0;
		display: flex;
		gap: 0.8em;
		flex-wrap: wrap;
		justify-content: center;
	}

	.filter-btn {
		padding: 0.6em 1.2em;
		background: rgb(var(--gray-light));
		border: none;
		border-radius: 20px;
		cursor: pointer;
		transition: all 0.2s;
		font-size: 0.9em;
		font-weight: 500;
		color: rgb(var(--gray-dark));
	}

	.filter-btn.active {
		background: var(--accent);
		color: white;
	}

	.filter-btn:hover {
		background: var(--accent);
		color: white;
		transform: translateY(-2px);
	}

	.news-timeline {
		display: grid;
		gap: 2em;
		margin: 3em 0;
	}

	.news-card {
		padding: 2em;
		background: white;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
		border-left: 4px solid var(--accent);
		transition: transform 0.2s;
	}

	.news-image {
		width: 100%;
		max-width: 640px;
		height: auto;
		border-radius: 8px;
		margin: 0.5em 0 1em 0;
		display: block;
	}

	.news-card:hover {
		transform: translateY(-3px);
	}

	.news-meta {
		display: flex;
		gap: 1em;
		align-items: center;
		margin-bottom: 1em;
	}

	.category {
		padding: 0.3em 0.8em;
		background: var(--accent);
		color: white;
		border-radius: 15px;
		font-size: 0.8em;
		font-weight: 600;
	}

	.news-card h2 {
		margin-bottom: 1em;
		color: rgb(var(--black));
		font-size: 1.3em;
		line-height: 1.4;
	}

	.news-card p {
		color: rgb(var(--gray));
		line-height: 1.6;
		margin-bottom: 1.5em;
	}

	.news-actions {
		margin-top: 1em;
	}

	.read-more {
		display: inline-block;
		color: var(--accent);
		text-decoration: none;
		font-weight: 600;
		transition: color 0.2s;
	}

	.read-more:hover {
		color: var(--accent-dark);
		text-decoration: underline;
	}

	.news-summary {
		margin: 4em 0;
		padding: 2em 0;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.news-summary h2 {
		text-align: center;
		margin-bottom: 2em;
		color: rgb(var(--black));
	}

	.summary-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 2em;
	}

	.summary-card {
		text-align: center;
		padding: 2em;
		background: white;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
		transition: transform 0.2s;
	}

	.summary-card:hover {
		transform: translateY(-5px);
	}

	.summary-card h3 {
		margin-bottom: 1em;
		color: rgb(var(--black));
		font-size: 1.2em;
	}

	.summary-number {
		font-size: 2.5em;
		font-weight: 700;
		color: var(--accent);
		margin: 0.5em 0;
	}

	.summary-text {
		color: rgb(var(--gray));
		font-size: 0.9em;
		margin: 0;
	}

	@media (max-width: 768px) {
		.news-filters {
			gap: 0.5em;
		}

		.filter-btn {
			padding: 0.5em 1em;
			font-size: 0.8em;
		}

		.news-card {
			padding: 1.5em;
		}

		.news-card h2 {
			font-size: 1.2em;
		}

		.summary-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 1em;
		}

		.summary-card {
			padding: 1.5em;
		}

		.summary-number {
			font-size: 2em;
		}

		.page-header {
			padding: 1em 0;
			margin-bottom: 2em;
		}
	}

	@media (max-width: 480px) {
		.summary-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	// Filter functionality
	document.addEventListener('DOMContentLoaded', function() {
		const filterButtons = document.querySelectorAll('.filter-btn');
		const newsCards = document.querySelectorAll('.news-card');

		filterButtons.forEach(button => {
			button.addEventListener('click', function(this: HTMLElement) {
				const category = this.getAttribute('data-category');

				// Update active button
				filterButtons.forEach(btn => btn.classList.remove('active'));
				this.classList.add('active');

				// Filter news cards
				newsCards.forEach(card => {
					const cardCategory = card.getAttribute('data-category');
					const cardElement = card as HTMLElement;
					if (category === 'all' || cardCategory === category?.toLowerCase()) {
						cardElement.style.display = 'block';
					} else {
						cardElement.style.display = 'none';
					}
				});
			});
		});
	});
</script>
